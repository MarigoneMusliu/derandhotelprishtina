<IfModule mod_rewrite.c>
  RewriteEngine On

  # One canonical host: derandhotel.com -> www.derandhotel.com
  RewriteCond %{HTTP_HOST} ^derandhotel\.com$ [NC]
  RewriteRule ^(.*)$ https://www.derandhotel.com/$1 [R=301,L]

  # Never serve development / tooling files
  RewriteRule ^(_|tools/) - [F,L]
  RewriteRule \.(py|pyc|ini|toml|md|log|bak|sh)$ - [F,L]
</IfModule>

<FilesMatch "^(raiaccept-private-config|raiaccept-config|_raiaccept-config).*(\.php)?$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteRule ^api/(raiaccept-config|_raiaccept-config|otello-config).*\.php$ - [F,L]
  RewriteRule ^api/_storage(/|$) - [F,L]
  RewriteRule ^api/\.otello- - [F,L]
</IfModule>

# BEGIN clean-urls (generated by _tools/clean_urls.py)
<IfModule mod_rewrite.c>
